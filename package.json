{
  "name": "ctfcodebox",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @ctfcodebox/web",
    "build": "npm run typecheck && npm run build --workspace @ctfcodebox/web",
    "preview": "npm run preview --workspace @ctfcodebox/web",
    "cli": "node apps/cli/dist/index.js",
    "typecheck": "tsc -b && tsc -p apps/web/tsconfig.json --noEmit",
    "format": "prettier --write . --ignore-path .gitignore",
    "format:check": "prettier --check . --ignore-path .gitignore",
    "check": "npm run format:check && npm run build"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100,
    "tabWidth": 2,
    "trailingComma": "all",
    "endOfLine": "lf"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.2.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.6"
  }
}
