{
  "name": "ctfcodebox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "minimatch": "11.0.1"
  },
  "scripts": {
    "dev": "npm run dev --workspace @ctfcodebox/web",
    "build": "tsc -b && npm run build --workspace @ctfcodebox/web",
    "preview": "npm run preview --workspace @ctfcodebox/web",
    "cli": "node apps/cli/dist/index.js",
    "typecheck": "tsc -b && tsc -p apps/web/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.2.1",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6"
  }
}
